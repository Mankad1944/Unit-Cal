# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas URI for production)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/unitcalc?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unitcalc?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a random 64-char string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production

# Frontend Application URL (Vercel deployment domain)
FRONTEND_URL=https://your-frontend-domain.vercel.app

